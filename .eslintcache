=\"_blank\">\r\n          <MdDeveloperMode style={{ marginBottom: \"2px\" }} /> shri adhik agency\r\n        </Navbar.Brand> */}\r\n        <Navbar.Brand\r\n          href=\"https://distributors.leotaps.com/leo-taps-fittings/dealers-in-ahmedabad/dealers-in-Sarkhej/leo-taps-and-fittings-shri-adhik-agencies-in-Sarkhej-ahmedabad--3CoX8a/home\"\r\n          target=\"_blank\"\r\n          style={{ display: \"flex\", alignItems: \"center\", gap: \"8px\" }}\r\n        >\r\n\r\n          <img\r\n            src={logo}\r\n            style={{ height: \"28px\" }}\r\n          />\r\n\r\n          <span>Shri Adhik Agency</span>\r\n        </Navbar.Brand>\r\n        <Navbar.Toggle\r\n          aria-controls=\"responsive-navbar-nav\"\r\n          onClick={() => {\r\n            updateExpanded(expand ? false : \"expanded\");\r\n          }}\r\n        >\r\n          <span></span>\r\n          <span></span>\r\n          <span></span>\r\n        </Navbar.Toggle>\r\n        <Navbar.Collapse id=\"responsive-navbar-nav\">\r\n          <Nav className=\"ml-auto\" defaultActiveKey=\"#home\">\r\n            <Nav.Item>\r\n              <Nav.Link as={Link} to=\"/\" onClick={() => updateExpanded(false)}>\r\n                <AiOutlineHome style={{ marginBottom: \"2px\" }} /> Home\r\n              </Nav.Link>\r\n            </Nav.Item>\r\n\r\n            <Nav.Item>\r\n              <Nav.Link\r\n                as={Link}\r\n                to=\"/about\"\r\n                onClick={() => updateExpanded(false)}\r\n              >\r\n                <AiOutlineUser style={{ marginBottom: \"2px\" }} /> About\r\n              </Nav.Link>\r\n            </Nav.Item>\r\n\r\n            {/* <Nav.Item>\r\n              <Nav.Link\r\n                as={Link}\r\n                to=\"/project\"\r\n                onClick={() => updateExpanded(false)}\r\n              >\r\n                <AiOutlineFundProjectionScreen\r\n                  style={{ marginBottom: \"2px\" }}\r\n                />{\" \"}\r\n                Projects\r\n              </Nav.Link>\r\n            </Nav.Item> */}\r\n\r\n            <Nav.Item>\r\n              <Nav.Link\r\n                as={Link}\r\n                to=\"/brands\"\r\n                onClick={() => updateExpanded(false)}\r\n              >\r\n                <GiKitchenTap style={{ marginBottom: \"2px\" }} /> Brands\r\n              </Nav.Link>\r\n            </Nav.Item>\r\n\r\n             <Nav.Item>\r\n              <Nav.Link\r\n                as={Link}\r\n                to=\"/contact\"\r\n                onClick={() => updateExpanded(false)}\r\n              >\r\n                <IoMdContacts style={{ marginBottom: \"2px\" }} /> Contact\r\n              </Nav.Link>\r\n            </Nav.Item>\r\n\r\n            {/* <Nav.Item>\r\n              <Nav.Link\r\n                href=\"https://distributors.leotaps.com/leo-taps-fittings/dealers-in-ahmedabad/dealers-in-Sarkhej/leo-taps-and-fittings-shri-adhik-agencies-in-Sarkhej-ahmedabad--3CoX8a/home\"\r\n                target=\"_blank\"\r\n                rel=\"noreferrer\"\r\n              >\r\n                <IoMdContacts style={{ marginBottom: \"2px\" }} /> Contact\r\n              </Nav.Link>\r\n            </Nav.Item> */}\r\n          </Nav>\r\n        </Navbar.Collapse>\r\n      </Container>\r\n    </Navbar>\r\n  );\r\n}\r\n\r\nexport default NavBar;\r\n","D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\Footer.js",[],"D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\ScrollToTop.js",[],"D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\Home\\Home.js",[],"D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\About\\About.js",["158","159","160"],"import React from \"react\";\r\nimport { Container, Row, Col } from \"react-bootstrap\";\r\nimport Techstack from \"./Techstack\";\r\nimport Aboutcard from \"./AboutCard\";\r\nimport developer from \"../../Assets/about.jpeg\";\r\nimport { SKILLS, TOOLS } from \"../../Constants\";\r\n\r\nfunction About() {\r\n  return (\r\n    <Container fluid className=\"about-section\">\r\n      <Container>\r\n        <Row style={{ justifyContent: \"center\", padding: \"10px\" }}>\r\n          <Col\r\n            md={7}\r\n            style={{\r\n              justifyContent: \"center\",\r\n              paddingTop: \"30px\",\r\n              paddingBottom: \"50px\",\r\n            }}\r\n          >\r\n            <h1 style={{ fontSize: \"2.1em\", paddingBottom: \"20px\" }}>\r\n              <strong className=\"purple\">About Me</strong>\r\n            </h1>\r\n            <Aboutcard />\r\n          </Col>\r\n          <Col md={5} style={{ paddingBottom: \"50px\" }} className=\"about-img\">\r\n            <img src={developer} alt=\"about\" className=\"image-style\" />\r\n          </Col>\r\n        </Row>\r\n        {/* <Row className=\"skill-tools-wrapper\">\r\n          <Col className=\"skill-wrapper\">\r\n            <h1 className=\"project-heading\">\r\n              Professional <strong className=\"purple\">Skillset </strong>\r\n            </h1>\r\n            {SKILLS.map((skill, index) => (\r\n              <Techstack\r\n                name={skill.name}\r\n                initialRating={skill.initialRating}\r\n                key={index}\r\n              />\r\n            ))}\r\n          </Col>\r\n          <Col className=\"skill-wrapper\">\r\n            <h1 className=\"project-heading\">\r\n              <strong className=\"purple\">Tools</strong> I use\r\n            </h1>\r\n            {TOOLS.map((tool, index) => (\r\n              <ul key={index} className=\"tool-name\">\r\n                <li>{tool}</li>\r\n              </ul>\r\n            ))}\r\n          </Col>\r\n        </Row> */}\r\n      </Container>\r\n    </Container>\r\n  );\r\n}\r\n\r\nexport default About;\r\n","D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\Projects\\Projects.js",[],"D:\\Riya\\Website\\dhrivinPortfolio\\src\\components\\Preloader.js",["161"],"import React from \"react\";\r\nimport Loader from \"re